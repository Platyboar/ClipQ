{
    "name": "clipq-dev-checks",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "description": "Development linters and verification checks for ClipQ",
    "scripts": {
        "lint:js": "eslint app/public/js",
        "lint:css": "stylelint \"app/public/css/**/*.css\"",
        "lint:html": "htmlhint app/public/index.html",
        "check": "python -B tests/check_all.py"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "globals": "^17.14.0",
        "htmlhint": "^1.9.2",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0"
    }
}
